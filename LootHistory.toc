## Interface: 120007
## Title: Ka0s Loot History
## Notes: Records every item you loot, attributes its source, and browses the history.
## Author: add1kted2ka0s
## Version: 1.2.0
## IconTexture: Interface\Icons\inv_holiday_christmas_present_03
## SavedVariables: LootHistoryDB
## OptionalDeps: Ace3, LibStub, CallbackHandler-1.0, LibSharedMedia-3.0, LibDataBroker-1.1, LibDBIcon-1.0
## DefaultState: enabled
## Category-enUS: Misc
## X-License: MIT
## X-Standard: https://github.com/tusharsaxena/WowAddonStandards
## X-Curse-Project-ID: 1607560

# Libraries (vendored in libs/ — load first)
libs\LibStub\LibStub.lua
libs\CallbackHandler-1.0\CallbackHandler-1.0.xml
libs\AceAddon-3.0\AceAddon-3.0.xml
libs\AceEvent-3.0\AceEvent-3.0.xml
libs\AceTimer-3.0\AceTimer-3.0.xml
libs\AceConsole-3.0\AceConsole-3.0.xml
libs\AceDB-3.0\AceDB-3.0.xml
libs\AceGUI-3.0\AceGUI-3.0.xml
libs\LibSharedMedia-3.0\lib.xml
libs\LibDataBroker-1.1\LibDataBroker-1.1.lua
libs\LibDBIcon-1.0\LibDBIcon-1.0.lua
libs\LibKa0s\LibKa0s.xml

# Locales
locales\enUS.lua

# Core (Compat loads first)
core\Compat.lua
# The LibKa0s-Env seam. After Compat, whose map, zone and TOC-metadata shims it took over;
# nothing here resolves at load, so the position is conventional rather than load-bearing.
core\EnvSetup.lua
# The LibKa0s-Item seam. LOAD-BEARING POSITION: publishes NS.Item, whose QualityLabel
# core\Constants.lua calls at file load to build the quality threshold labels. Below
# Constants and that loop raises on a nil field.
core\ItemSetup.lua
# LOAD-BEARING POSITION: publishes NS.MediaFont, which core\Constants.lua reads at file
# load to resolve FONT_MONO. Below Constants and every consumer silently gets the client font.
core\MediaSetup.lua
core\Constants.lua
core\Namespace.lua
core\State.lua
core\Util.lua
core\CoreSetup.lua
# Needs core\MediaSetup.lua above it: the dropdown art is resolved through NS.Icon.
core\WidgetsSetup.lua
core\DebugLogSetup.lua
# The LibKa0s-Pool seam. Before every module that pools a widget (Analytics, BrowserTable).
core\PoolSetup.lua
core\LootHistory.lua
core\Database.lua

# Defaults
defaults\Global.lua

# Modules (Attribution before Collector)
modules\Attribution.lua
modules\Filters.lua
modules\AuctionPrice.lua
modules\Collector.lua
modules\Browser.lua
modules\BrowserTable.lua
modules\Export.lua
modules\Analytics.lua

# Settings
# LOAD-BEARING POSITION: settings\Schema.lua composes its Master controls tab at FILE LOAD
# through NS.Options.MasterControls (options-ui-§15), so the Options seam has to have published
# NS.Options by then. Nothing in this file resolves at load -- every descriptor field is a closure
# over NS.Schema / NS.Panel -- so moving it above Schema costs nothing and buys the composer.
settings\OptionsSetup.lua
settings\Schema.lua
settings\Slash.lua
settings\Panel.lua
