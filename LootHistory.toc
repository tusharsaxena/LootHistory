## Interface: 120105, 16001
## Title: Ka0s Loot History
## Notes: Records every item you loot, attributes its source, and browses the history.
## Author: add1kted2ka0s
## Version: 1.5.0
## IconTexture: Interface\AddOns\LootHistory\media\logos\loothistory.logo.128.tga
## SavedVariables: LootHistoryDB, LootHistoryPerfDB
## OptionalDeps: Ace3, LibStub, CallbackHandler-1.0, LibSharedMedia-3.0, LibDataBroker-1.1, LibDBIcon-1.0, EllesmereUI
## DefaultState: enabled
## Category-enUS: Misc
## X-License: MIT
## X-Standard: https://github.com/tusharsaxena/WowAddonStandards
## X-Curse-Project-ID: 1607560

# Libraries (vendored in libs/ — load first)
libs\LibStub\LibStub.lua
libs\CallbackHandler-1.0\CallbackHandler-1.0.xml
libs\AceAddon-3.0\AceAddon-3.0.xml
libs\AceEvent-3.0\AceEvent-3.0.xml
libs\AceTimer-3.0\AceTimer-3.0.xml
libs\AceConsole-3.0\AceConsole-3.0.xml
libs\AceDB-3.0\AceDB-3.0.xml
libs\AceGUI-3.0\AceGUI-3.0.xml
libs\AceConfig-3.0\AceConfig-3.0.xml
libs\AceDBOptions-3.0\AceDBOptions-3.0.xml
libs\LibSharedMedia-3.0\lib.xml
libs\LibDataBroker-1.1\LibDataBroker-1.1.lua
libs\LibDBIcon-1.0\LibDBIcon-1.0.lua
libs\LibKa0s\LibKa0s.xml

# Locales
# CONVENTIONAL: nothing below reads a locale key at load.
locales\enUS.lua

# Core (Compat loads first)
core\Compat.lua
# LOAD-BEARING POSITION: the client and the character (clients-§3): IsForever / IsRetail / ClientKey /
# ForClient and the name readers, LibKa0s-Compat-1.0's, routed onto NS.Compat. Straight after
# core\Compat.lua and above core\SimSeam.lua, so the seam wraps its members too.
core\CompatClient.lua
# LOAD-BEARING POSITION: the holdings tooltip's client reads (#34), split out of core\Compat.lua.
# Below core\CompatClient.lua (its IsSecret is read at call time) and above core\SimSeam.lua
# (core\CompatProgress.lua, core\CompatGain.lua and core\CompatFarm.lua between), so the seam wraps its live reads too.
core\CompatTooltip.lua
# LOAD-BEARING POSITION: the reputation and appearance reads (rep/appearance spec §3.2), split
# out of core\Compat.lua. Below core\CompatClient.lua (its IsSecret is read at call time) and
# above core\SimSeam.lua (core\CompatGain.lua and core\CompatFarm.lua between), so the seam wraps its reads and guards
# ListFactions.
core\CompatProgress.lua
# LOAD-BEARING POSITION: adds members to NS.Compat at file load (the gain feed's client reads, #38).
# Below core\CompatClient.lua, whose IsSecret it reads at call time; ABOVE core\SimSeam.lua, which wraps
# every member in place at its own load, so a member defined below the seam escapes it (H2,
# NS.SimSeam:Unwrapped()).
core\CompatGain.lua
# LOAD-BEARING POSITION: a compat family file (the farm session's reads, #39), listed contiguously
# after core\CompatGain.lua and above core\SimSeam.lua, whose Sim:NewSeam wraps every NS.Compat
# member at file load; a member added below the seam escapes the wrap (NS.SimSeam:Unwrapped(),
# tests/test_sim_seam.lua). Its IsSecret reads (core\CompatClient.lua) are at call time.
core\CompatFarm.lua
# LOAD-BEARING POSITION: LibKa0s-Sim-1.0's answer seam (H2). Sim:NewSeam wraps every NS.Compat
# member in place at FILE LOAD, so it must load STRAIGHT after the compat family (core\Compat.lua,
# core\CompatClient.lua, core\CompatTooltip.lua, core\CompatProgress.lua, core\CompatGain.lua,
# core\CompatFarm.lua) and before any file
# that reads a Compat member; a member added below it escapes the wrap (NS.SimSeam:Unwrapped(),
# asserted empty by tests/test_sim_seam.lua). Publishes NS.SimSeam (or the inert stub without the
# library) and NS.SimHost; NS.State and NS.Debug are read at call time.
core\SimSeam.lua
# The LibKa0s-Env seam. After Compat, whose map, zone and TOC-metadata shims it took over;
# nothing here resolves at load, so the position is conventional rather than load-bearing.
core\EnvSetup.lua
# The LibKa0s-Item seam. LOAD-BEARING POSITION: publishes NS.Item, whose QualityLabel
# core\Constants.lua calls at file load to build the quality threshold labels. Below
# Constants and that loop raises on a nil field.
core\ItemSetup.lua
# LOAD-BEARING POSITION: publishes NS.MediaFont, which core\Constants.lua reads at file
# load to resolve FONT_MONO. Below Constants and every consumer silently gets the client font.
core\MediaSetup.lua
# The plain Core run (Constants, Namespace, State, Util, Ledger here; LootHistory, Database below) is
# CONVENTIONAL: none of the seven reads another of the seven at load. Its fixed points are the seams
# annotated around it, and the run as a whole stays above Modules, which take NS.State and
# NS.Constants as file-scope upvalues.
core\Constants.lua
core\Namespace.lua
core\State.lua
core\Util.lua
core\Ledger.lua
# LOAD-BEARING POSITION: lib:New{ prefix = NS.PREFIX } runs at file load (core\Namespace.lua must
# be above), and NS.Print, published here, is captured as a file-scope local by modules\Browser.lua,
# settings\Schema.lua and settings\Slash.lua (must be below them).
core\CoreSetup.lua
# LOAD-BEARING POSITION: the LibKa0s-Skin-1.0 seam (skinning-§3). Registers the owner and publishes
# NS.Skin, NS.SKIN_OPTIONS and NS.SKIN_SOURCE_OPTIONS at file load; settings\Schema.lua reads the
# two option lists at file load and every frame-building file reads NS.Skin, so it must be above
# core\WidgetsSetup.lua and every module. Below core\CoreSetup.lua, whose NS.ApplySkin the degraded
# facade's Shell calls (at call time) and whose NS.Print the reload line uses.
core\SkinSetup.lua
# LOAD-BEARING POSITION: publishes NS.EVENT_ROWS / NS.HOOK_ROWS and NS.EventRow / NS.HookRow,
# which modules\Attribution.lua, modules\AttributionOut.lua, modules\Collector.lua,
# modules\Reputation.lua, modules\Appearance.lua, modules\Progress.lua and modules\Reconciler.lua call at FILE LOAD to append their capture rows; it must be above every
# module. Row order is TOC order. Nothing here resolves at load (NS.SafeRegisterEvent, from
# core\CoreSetup.lua above, is read at call time).
core\Dispatch.lua
# The LibKa0s-Lifecycle-1.0 seam: the ONE latch every reason to be inert holds
# (slash-commands-§7). LOAD-BEARING relative to core\PerfSetup.lua only, which hands NS.Lifecycle
# to lib:New at file load; nothing in this file resolves at load (every field is a closure and the
# printer is late-bound), and the latch is first TOUCHED from addon:OnEnable.
core\LifecycleSetup.lua
# LOAD-BEARING POSITION: the LibKa0s-Perf-1.0 seam (performance-§1). lib:New reads NS.Lifecycle
# (above) and NS.Version (core\EnvSetup.lua, above) at file load, and it must sit above every module
# that takes `local Perf = NS.Perf` as a load-time upvalue (Collector, Reputation, Appearance,
# Attribution, Reconciler).
core\PerfSetup.lua
# CONVENTIONAL: the dropdown and reorder art resolves through NS.Icon (core\MediaSetup.lua) at
# call time, inside NS.MakeDropdown / NS.MakeReorderList; nothing is read at load. Kept below Media.
core\WidgetsSetup.lua
# LOAD-BEARING POSITION: the file-load lib:New descriptor reads NS.Constants.FONT_MONO;
# core\Constants.lua must be above.
core\DebugLogSetup.lua
# The LibKa0s-Pool seam. CONVENTIONAL: nothing resolves at load; every NS.Pool.New call is inside
# a function (modules/AnalyticsLedger.lua:157).
core\PoolSetup.lua
# The LibKa0s-Feed seam (#38). CONVENTIONAL: it resolves the major (libs\LibKa0s\LibKa0s.xml, above)
# and publishes NS.FeedLib / NS.NewFeed / NS.FeedStub; nothing calls NS.NewFeed at load
# (modules\ToastFeed.lua builds its feeds from Toasts:Enable). Kept beside the other LibKa0s seams.
core\FeedSetup.lua
core\LootHistory.lua
core\Database.lua
# The LibKa0s-Launcher seam: the minimap button and the broker plugin as ONE object
# (launcher-§1). Position is CONVENTIONAL, not load-bearing -- nothing here resolves at
# load (`minimap` is a function, every other field a closure) and `Register()` runs from
# addon:OnInitialize, after NS:InitDB has made db.global.minimap exist.
core\LauncherSetup.lua

# Defaults
# LOAD-BEARING POSITION: settings\Schema.lua takes both defaults tables as file-scope locals and
# reads their values into the rows' defaults at file load, so both files must be above Schema.
# Global is the account-wide half (the loot history, its retention, the stamp, the minimap table);
# Profile is every other setting. Neither reads the other, so their relative order is conventional.
defaults\Global.lua
defaults\Profile.lua

# Modules
# CONVENTIONAL: every modules\ position below that carries no annotation of its own. Each such file
# publishes its own table idempotently and reaches its siblings only inside functions (Collector
# calls NS.Attribution at capture time, never at load); what it binds at load comes from core\.
modules\Attribution.lua
modules\AttributionOut.lua
# LOAD-BEARING POSITION: the gain feed (#38), the one sender of Ka0s_LootHistory_Gain. Collector,
# Reputation, Appearance, Progress and Reconciler bind NS.GainFeed as a file-scope local at load (the
# capture hot path tests one field, events-frames-taint-§7), so it must be above all five; it binds
# NS.Perf (core\PerfSetup.lua) and NS.Ledger (core\Ledger.lua), which are above. It appends no row.
modules\GainFeed.lua
# CONVENTIONAL as a load position, but kept directly below the two Attribution files (and the gain
# feed, which has no row) and above
# modules\Reconciler.lua on purpose: its capture rows append to NS.EVENT_ROWS at file load, and
# row order is TOC order, which this keeps equal to the stand-up order (Attribution,
# AttributionOut, Collector, Reputation, Appearance, Progress, Reconciler; core\LifecycleSetup.lua).
modules\Collector.lua
# CONVENTIONAL as a load position, kept directly below modules\Collector.lua for the same reason:
# its one capture row (FACTION_STANDING_CHANGED) appends at file load, and the stand-up order puts
# the Reputation owner straight after the Collector.
modules\Reputation.lua
# CONVENTIONAL as a load position, kept directly below modules\Reputation.lua for the same reason:
# its two capture rows (TRANSMOG_COLLECTION_SOURCE_ADDED / _REMOVED, Retail only by declaration)
# append at file load, and the stand-up order puts the Appearance owner straight after Reputation.
modules\Appearance.lua
# CONVENTIONAL as a load position, kept directly below modules\Appearance.lua for the same reason:
# its capture rows (the experience, skill and regen rows, #38) append at file load, and the stand-up
# order puts the Progress owner straight after Appearance. Binds NS.GainFeed at load (above).
modules\Progress.lua
modules\Filters.lua
modules\Scanner.lua
modules\Holdings.lua
modules\Rollup.lua
modules\Reconciler.lua
# LOAD-BEARING POSITION: appends to NS.Reconciler.SCAN_STEPS/PLAN_STEPS/COMMIT_STEPS at file load;
# modules\Reconciler.lua must be above.
modules\Escrow.lua
modules\AuctionPrice.lua
modules\LedgerFormat.lua
# LOAD-BEARING POSITION: publishes B._dataset, B._withAll, B._options and the Bound labels, which
# modules\Browser.lua binds as file-scope locals at load; it must be above modules\Browser.lua.
modules\BrowserWidgets.lua
modules\Browser.lua
# LOAD-BEARING POSITION: the History window's per-tab view layer, peeled off modules\Browser.lua;
# it publishes B._setToFilter, B._applyFilter and their siblings, which the filter bar below binds
# at load, so it sits between the two.
modules\BrowserViews.lua
# LOAD-BEARING POSITION: binds modules\BrowserViews.lua's B._setToFilter, B._applyFilter and
# their siblings, and modules\BrowserWidgets.lua's B._options, as file-scope locals at load;
# both must be above.
modules\BrowserFilterBar.lua
modules\BrowserTable.lua
# LOAD-BEARING POSITION: binds modules\BrowserTable.lua's BrowserTable._columnByKey and
# BrowserTable._groupColumn as file-scope locals at load; modules\BrowserTable.lua must be above.
modules\BrowserTableGroup.lua
# LOAD-BEARING POSITION: reads NS.BrowserTable at file load, and modules\TestData.lua below reads its
# BrowserTable.TestSample; modules\BrowserTable.lua must be above and modules\TestData.lua below.
modules\BrowserTableTestData.lua
modules\Export.lua
modules\AnalyticsFormat.lua
# LOAD-BEARING POSITION: binds Analytics.K, Analytics._fmt and the Analytics._* helpers as file-scope
# locals at load; modules\AnalyticsFormat.lua, which publishes them, must be above.
modules\Analytics.lua
# The LibKa0s-Charts seam. Publishes NS.Analytics idempotently; modules\Analytics.lua reaches what it
# publishes at call time, so nothing here is load-bearing against the file above.
modules\AnalyticsCharts.lua
modules\AnalyticsLedger.lua
# LOAD-BEARING POSITION: calls NS.Browser:RegisterTab at file load; modules\Browser.lua must be above.
modules\HoldingsTab.lua
# CONVENTIONAL: the holdings tally (#34). Reads NS.Constants at load (core\, fixed by section
# order) and NS.Holdings, NS.Compat, NS.Reconciler, NS.Sim and NS.Util at call time; kept beside
# the Holdings tab because both read the same store.
modules\HoldingsTally.lua
# LOAD-BEARING POSITION: binds NS.HoldingsTally and NS.Perf as file-scope upvalues at load (the
# tooltip post call's hot path, events-frames-taint-§7 / performance-§2); modules\HoldingsTally.lua
# and core\PerfSetup.lua must be above.
modules\HoldingsTip.lua
# LOAD-BEARING POSITION: binds NS.HoldingsTally at load, and publishes _G.LootHistory (public-api) at
# file load so an addon reading it at its own PLAYER_LOGIN finds it. modules\HoldingsTally.lua must
# be above.
modules\HoldingsAPI.lua
modules\TimelineModel.lua
# LOAD-BEARING POSITION: reads NS.TimelineModel's TOTAL and calls NS.Browser:RegisterTab at file
# load; modules\TimelineModel.lua and modules\Browser.lua must be above.
modules\Timeline.lua
# LOAD-BEARING POSITION: farm mode's pure session model (#39); binds NS.Constants at load only.
# modules\Farm.lua (and the farm windows, M4.2 on) bind NS.FarmModel as a file-scope upvalue at load,
# so it must be above them.
modules\FarmModel.lua
# LOAD-BEARING POSITION: binds NS.FarmModel and NS.Perf as file-scope upvalues at load (the gain feed
# and loot-window hot paths, performance-§2); modules\FarmModel.lua and core\PerfSetup.lua must be
# above. Appends its three EVENT_ROWS at file load (core\Dispatch.lua above). Calls
# NS.GainFeed:SetFarm and subscribes to NS.MSG.GAIN at call time only.
modules\Farm.lua
# CONVENTIONAL: the farm windows' list widget (#39); it binds nothing at load (NS.Pool, NS.Skin and the
# FauxScrollFrame globals at call time). Kept above the farm windows, which reach it.
modules\FarmList.lua
# LOAD-BEARING POSITION: binds NS.FarmModel as a file-scope upvalue at load; modules\FarmModel.lua must
# be above. Reaches NS.Farm, NS.Browser and NS.Pool at call time only (it builds its frame lazily).
modules\FarmPanel.lua
modules\TestData.lua
# CONVENTIONAL: the toast feeds' pure config, filter and merge (#38); binds NS.Constants at load only.
modules\ToastModel.lua
# CONVENTIONAL: the toast row content (#38); binds NS.Constants at load only, every other read at
# call time.
modules\ToastContent.lua
# LOAD-BEARING POSITION: binds NS.ToastModel and NS.ToastContent as file-scope locals at load and
# appends its two combat rows to NS.EVENT_ROWS at file load; modules\ToastModel.lua and
# modules\ToastContent.lua must be above. NS.NewFeed (core\FeedSetup.lua) is read at call time.
modules\ToastFeed.lua
# CONVENTIONAL: the sample toasts (#38); reached from NS.Toasts at call time only.
modules\ToastSample.lua
# CONVENTIONAL: Blizzard alert hiding (#38); reads NS.GainFeed and NS.Compat at call time only.
modules\ToastBlizz.lua
# LOAD-BEARING POSITION: the simulator's world. Registers its providers on NS.SimSeam at file load,
# so core\SimSeam.lua must be above; publishes NS.SimHost.World, which modules\SimDrivers.lua binds
# at load and modules\Sim.lua's prepare reads at call time.
modules\SimWorld.lua
# LOAD-BEARING POSITION: the simulator's event and hook drivers. Binds NS.SimHost.World at file
# load, so modules\SimWorld.lua must be above; fires through NS.Sim at call time only.
modules\SimDrivers.lua
# LOAD-BEARING POSITION: the simulator's six scenarios and its ledger gate. Binds NS.SimHost.World
# and NS.SimHost.Drivers at file load, so modules\SimWorld.lua and modules\SimDrivers.lua must be
# above; fills NS.SimHost.SCENARIOS in place, which modules\Sim.lua hands to Sim:New.
modules\SimScenario.lua
# LOAD-BEARING POSITION: the simulator's session host. Sim:New binds NS.SimSeam (core\SimSeam.lua)
# at file load, and the file registers its stop steps on NS.Sim:OnStop there; it publishes NS.Sim,
# NS.SimStop and NS.SimBlocks. Below every capture module and core\Dispatch.lua (NS.DeliverAll,
# NS.RealEventFilter, read at call time) and above settings\, whose destructive surfaces call
# NS.SimBlocks at call time. The simulator's world, driver and scenario modules sit above it.
modules\Sim.lua
# LOAD-BEARING POSITION: the simulation step panel's presentation fields and the History window's
# simulation marker. Fills NS.SimHost.PANEL, which modules\Sim.lua hands to Sim:New, and calls
# NS.Sim:AddListener at file load, so modules\Sim.lua must be above.
modules\SimPanel.lua
modules\Diagnostics.lua
# CONVENTIONAL: the WoW Forever port's probe verbs (ruling R4), reached from the `debug` row in
# settings\Schema.lua at call time; nothing here resolves at load.
modules\Probe.lua

# Settings
# LOAD-BEARING POSITION: settings\Schema.lua composes its Master controls tab at FILE LOAD
# through NS.Options.MasterControls (options-ui-§15), so the Options seam has to have published
# NS.Options by then. Nothing in this file resolves at load -- every descriptor field is a closure
# over NS.Schema / NS.Panel -- so moving it above Schema costs nothing and buys the composer.
settings\OptionsSetup.lua
# LOAD-BEARING POSITION: settings\Schema.lua appends NS.SchemaToasts.Rows() to its row array at file
# load, before the Schema runtime is built, so this must be above it; it calls NS.Options' composers
# (O.ColorPair / BorderGroup / FontGroup) and reads defaults\Profile.lua at load, so
# settings\OptionsSetup.lua and defaults\ must be above.
settings\SchemaToasts.lua
settings\Schema.lua
# LOAD-BEARING POSITION: the dispatcher is built at file load with commands = NS.COMMANDS, assigned
# by settings\Schema.lua; above Schema, LibKa0s-Slash lib:New raises (libs\LibKa0s\Slash.lua,
# checkDescriptor's "requires descriptor.commands" refusal) and /lh is never registered.
settings\Slash.lua
# LOAD-BEARING POSITION: reads NS.Schema.MASTER_GROUP and NS.Schema.MasterAfterGroup at file load;
# settings\Schema.lua must be above.
settings\Panel.lua
# LOAD-BEARING POSITION: binds settings\Panel.lua's P._acquire and P._runRebuilders as file-scope locals
# at load; settings\Panel.lua must be above.
settings\PanelAuction.lua
# LOAD-BEARING POSITION: binds settings\Panel.lua's P._makeMultiCheck as a file-scope local at load;
# settings\Panel.lua must be above. Its builder is registered from P:Register at call time.
settings\PanelToasts.lua
# CONVENTIONAL: the Profiles page's builder is registered from P:Register (settings\Panel.lua) at
# addon:OnInitialize, after General's, so nothing here resolves at load.
settings\Profiles.lua
