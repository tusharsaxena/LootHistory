## Interface: 120100
## Title: Ka0s Loot History
## Notes: Records every item you loot, attributes its source, and browses the history.
## Author: add1kted2ka0s
## Version: 1.4.0
## IconTexture: Interface\AddOns\LootHistory\media\logos\loothistory.logo.128.tga
## SavedVariables: LootHistoryDB, LootHistoryPerfDB
## OptionalDeps: Ace3, LibStub, CallbackHandler-1.0, LibSharedMedia-3.0, LibDataBroker-1.1, LibDBIcon-1.0
## DefaultState: enabled
## Category-enUS: Misc
## X-License: MIT
## X-Standard: https://github.com/tusharsaxena/WowAddonStandards
## X-Curse-Project-ID: 1607560

# Libraries (vendored in libs/ — load first)
libs\LibStub\LibStub.lua
libs\CallbackHandler-1.0\CallbackHandler-1.0.xml
libs\AceAddon-3.0\AceAddon-3.0.xml
libs\AceEvent-3.0\AceEvent-3.0.xml
libs\AceTimer-3.0\AceTimer-3.0.xml
libs\AceConsole-3.0\AceConsole-3.0.xml
libs\AceDB-3.0\AceDB-3.0.xml
libs\AceGUI-3.0\AceGUI-3.0.xml
libs\AceConfig-3.0\AceConfig-3.0.xml
libs\AceDBOptions-3.0\AceDBOptions-3.0.xml
libs\LibSharedMedia-3.0\lib.xml
libs\LibDataBroker-1.1\LibDataBroker-1.1.lua
libs\LibDBIcon-1.0\LibDBIcon-1.0.lua
libs\LibKa0s\LibKa0s.xml

# Locales
# CONVENTIONAL: nothing below reads a locale key at load.
locales\enUS.lua

# Core (Compat loads first)
core\Compat.lua
# The LibKa0s-Env seam. After Compat, whose map, zone and TOC-metadata shims it took over;
# nothing here resolves at load, so the position is conventional rather than load-bearing.
core\EnvSetup.lua
# The LibKa0s-Item seam. LOAD-BEARING POSITION: publishes NS.Item, whose QualityLabel
# core\Constants.lua calls at file load to build the quality threshold labels. Below
# Constants and that loop raises on a nil field.
core\ItemSetup.lua
# LOAD-BEARING POSITION: publishes NS.MediaFont, which core\Constants.lua reads at file
# load to resolve FONT_MONO. Below Constants and every consumer silently gets the client font.
core\MediaSetup.lua
# The plain Core run (Constants, Namespace, State, Util, Ledger here; LootHistory, Database below) is
# CONVENTIONAL: none of the seven reads another of the seven at load. Its fixed points are the seams
# annotated around it, and the run as a whole stays above Modules, which take NS.State and
# NS.Constants as file-scope upvalues.
core\Constants.lua
core\Namespace.lua
core\State.lua
core\Util.lua
core\Ledger.lua
# LOAD-BEARING POSITION: lib:New{ prefix = NS.PREFIX } runs at file load (core\Namespace.lua must
# be above), and NS.Print, published here, is captured as a file-scope local by modules\Browser.lua,
# settings\Schema.lua and settings\Slash.lua (must be below them).
core\CoreSetup.lua
# The LibKa0s-Lifecycle-1.0 seam: the ONE latch every reason to be inert holds
# (slash-commands-§7). LOAD-BEARING relative to core\PerfSetup.lua only, which hands NS.Lifecycle
# to lib:New at file load; nothing in this file resolves at load (every field is a closure and the
# printer is late-bound), and the latch is first TOUCHED from addon:OnEnable.
core\LifecycleSetup.lua
# LOAD-BEARING POSITION: the LibKa0s-Perf-1.0 seam (performance-§1). lib:New reads NS.Lifecycle
# (above) and NS.Version (core\EnvSetup.lua, above) at file load, and it must sit above every module
# that takes `local Perf = NS.Perf` as a load-time upvalue (Collector, Attribution, Reconciler).
core\PerfSetup.lua
# CONVENTIONAL: the dropdown and reorder art resolves through NS.Icon (core\MediaSetup.lua) at
# call time, inside NS.MakeDropdown / NS.MakeReorderList; nothing is read at load. Kept below Media.
core\WidgetsSetup.lua
# LOAD-BEARING POSITION: the file-load lib:New descriptor reads NS.Constants.FONT_MONO;
# core\Constants.lua must be above.
core\DebugLogSetup.lua
# The LibKa0s-Pool seam. CONVENTIONAL: nothing resolves at load; every NS.Pool.New call is inside
# a function (modules/Analytics.lua:213).
core\PoolSetup.lua
core\LootHistory.lua
core\Database.lua
# The LibKa0s-Launcher seam: the minimap button and the broker plugin as ONE object
# (launcher-§1). Position is CONVENTIONAL, not load-bearing -- nothing here resolves at
# load (`minimap` is a function, every other field a closure) and `Register()` runs from
# addon:OnInitialize, after NS:InitDB has made db.global.minimap exist.
core\LauncherSetup.lua

# Defaults
# LOAD-BEARING POSITION: settings\Schema.lua takes both defaults tables as file-scope locals and
# reads their values into the rows' defaults at file load, so both files must be above Schema.
# Global is the account-wide half (the loot history, its retention, the stamp, the minimap table);
# Profile is every other setting. Neither reads the other, so their relative order is conventional.
defaults\Global.lua
defaults\Profile.lua

# Modules
# CONVENTIONAL: every modules\ position below that carries no annotation of its own. Each such file
# publishes its own table idempotently and reaches its siblings only inside functions (Collector
# calls NS.Attribution at capture time, never at load); what it binds at load comes from core\.
modules\Attribution.lua
modules\AttributionOut.lua
modules\Filters.lua
modules\Scanner.lua
modules\Holdings.lua
modules\Rollup.lua
modules\Reconciler.lua
# LOAD-BEARING POSITION: appends to NS.Reconciler.SCAN_STEPS/PLAN_STEPS/COMMIT_STEPS at file load;
# modules\Reconciler.lua must be above.
modules\Escrow.lua
modules\AuctionPrice.lua
modules\Collector.lua
modules\LedgerFormat.lua
# LOAD-BEARING POSITION: publishes B._dataset, B._withAll, B._options and the Bound labels, which
# modules\Browser.lua binds as file-scope locals at load; it must be above modules\Browser.lua.
modules\BrowserWidgets.lua
modules\Browser.lua
# LOAD-BEARING POSITION: binds modules\Browser.lua's B._setToFilter, B._applyFilter, B._options and
# their siblings as file-scope locals at load; modules\Browser.lua must be above.
modules\BrowserFilterBar.lua
modules\BrowserTable.lua
# LOAD-BEARING POSITION: binds modules\BrowserTable.lua's BrowserTable._columnByKey and
# BrowserTable._groupColumn as file-scope locals at load; modules\BrowserTable.lua must be above.
modules\BrowserTableGroup.lua
modules\Export.lua
modules\AnalyticsFormat.lua
# LOAD-BEARING POSITION: binds Analytics.K, Analytics._fmt and the Analytics._* helpers as file-scope
# locals at load; modules\AnalyticsFormat.lua, which publishes them, must be above.
modules\Analytics.lua
# LOAD-BEARING POSITION: publishes NS.Analytics idempotently but binds Analytics.K at file load and
# writes Analytics._charts into it; modules\AnalyticsFormat.lua, which sets K, must be above.
modules\AnalyticsCharts.lua
modules\AnalyticsLedger.lua
# LOAD-BEARING POSITION: calls NS.Browser:RegisterTab at file load; modules\Browser.lua must be above.
modules\HoldingsTab.lua
modules\TimelineModel.lua
# LOAD-BEARING POSITION: reads NS.TimelineModel's TOTAL and calls NS.Browser:RegisterTab at file
# load; modules\TimelineModel.lua and modules\Browser.lua must be above.
modules\Timeline.lua
modules\TestData.lua
modules\Diagnostics.lua

# Settings
# LOAD-BEARING POSITION: settings\Schema.lua composes its Master controls tab at FILE LOAD
# through NS.Options.MasterControls (options-ui-§15), so the Options seam has to have published
# NS.Options by then. Nothing in this file resolves at load -- every descriptor field is a closure
# over NS.Schema / NS.Panel -- so moving it above Schema costs nothing and buys the composer.
settings\OptionsSetup.lua
settings\Schema.lua
# LOAD-BEARING POSITION: the dispatcher is built at file load with commands = NS.COMMANDS, assigned
# by settings\Schema.lua; above Schema, LibKa0s-Slash lib:New raises (libs\LibKa0s\Slash.lua,
# checkDescriptor's "requires descriptor.commands" refusal) and /lh is never registered.
settings\Slash.lua
# LOAD-BEARING POSITION: reads NS.Schema.MASTER_GROUP and NS.Schema.MasterAfterGroup at file load;
# settings\Schema.lua must be above.
settings\Panel.lua
# CONVENTIONAL: the Profiles page's builder is registered from P:Register (settings\Panel.lua) at
# addon:OnInitialize, after General's, so nothing here resolves at load.
settings\Profiles.lua
